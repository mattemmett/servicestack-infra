# Local-only overrides for development.
# Copy this file to .env.local and fill in the values you want to use locally.
# This file is intentionally not committed.

# AWS settings
# export AWS_PROFILE="servicestack-prod"
# export AWS_REGION="us-east-1"
# export AWS_DEFAULT_REGION="us-east-1"

# Terraform overrides (the Terraform equivalent of app dotenv values)
# Keep aws_region in environments/prod/terraform.tfvars as the single Terraform source of truth.
# Set TF_VAR_aws_region only for temporary one-off overrides.
# export TF_VAR_ssh_cidr_blocks='["203.0.113.10/32"]'
# export TF_VAR_host_instance_type="t3.small"
# export TF_VAR_host_ami_id="ami-098e39bafa7e7303d"
# export TF_VAR_route53_zone_name="service-stack.io"

# Optional secrets or app-specific values
# GHCR_USERNAME should be the GitHub username that owns the PAT.
# Deploy scripts accept either GHCR_TOKEN or GHCR_PAT.
# export GHCR_USERNAME="your-github-username"
# export GHCR_TOKEN=""
# export GHCR_PAT=""
# export GITHUB_TOKEN=""
