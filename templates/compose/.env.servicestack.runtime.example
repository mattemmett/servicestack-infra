# ServiceStack Runtime Environment Contract
#
# This file is the bridge from the old monorepo .env.dev style to the
# current infra-managed host runtime.
#
# Usage:
# 1) Copy to a local file outside source control (for example .env.runtime.local).
# 2) Replace placeholders with real values.
# 3) Upload to the host with scripts/push-env-to-host.sh.

# Environment
ENVIRONMENT=prod

# Database (RDS)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=servicestack
DB_USER=from-ssm-db-user
DB_PASSWORD=from-ssm-db-password
DB_SSLMODE=prefer

# Optional full SQLAlchemy URL
# SQLALCHEMY_DATABASE_URL=postgresql://user:pass@host:5432/servicestack

# Optional pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AWS
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Producer-owned exports source (read-only)
S3_BUCKET_NAME=servicestack-exports-warehouse-prod
S3_LOCATION_PREFIX=landingdc-160426

# Canonical ETL scope
SERVICESTACK_ACCOUNT_CODE=emmett-holdings-llc
SERVICESTACK_COMPANY_CODE=landing-dallas-city-llc
SERVICESTACK_LOCATION_CODE=landing-main

# Legacy aliases (optional)
# ETL_ACCOUNT_CODE=
# ETL_COMPANY_CODE=
# ETL_LOCATION_CODE=

# API
API_PORT=8000
API_HOST_URL=https://api.service-stack.io/api/v1/iip

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO

# Registry image selectors used by compose
APP_IMAGE=ghcr.io/mattemmett/servicestack:latest
IMAGE_TAG=latest
